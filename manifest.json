{
  "manifest_version": 3,
  "name": "Muslim Dashboard",
  "version": "1.2.0",
  "description": "Islamic dashboard on every new tab: prayer times, qibla direction, upcoming Islamic events, daily reminders, todo & weather.",
  "author": "Ahmad Abulkhair",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Muslim Dashboard"
  }
}